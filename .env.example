# Copy to .env and fill in as needed. Everything below is optional in
# development — the app runs fully in mock mode without any of it.

DATABASE_URL="file:./dev.db"

# Twilio (SMS + voice). Leave unset to log/mock all sends.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# If set, inbound calls ring this number first and only count as "missed"
# if unanswered. If unset, every inbound call is treated as missed.
FORWARD_CALLS_TO=

# Where instant "new HOT lead" alerts are texted. Falls back to FORWARD_CALLS_TO.
OWNER_NOTIFY_NUMBER=

# Google Calendar (OAuth). Leave unset to log/mock calendar events.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Protects /api/cron/tick. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` when configured.
CRON_SECRET=

# Seed values for the (single-tenant) business profile on first run.
BUSINESS_NAME="Summit Roofing & Exteriors"
BUSINESS_SERVICE_TYPE="Roofing"
BUSINESS_CITY="Austin, TX"
